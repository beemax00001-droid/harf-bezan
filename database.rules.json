{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null && (data.child('ownerUid').val() == auth.uid || data.child('guestUid').val() == auth.uid || !data.child('guestUid').exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid))",
        "guestUid": {
          ".write": "auth != null && (!data.exists() || data.val() == auth.uid) && newData.val() == auth.uid"
        },
        "status": {
          ".write": "auth != null && (auth.uid == data.parent().child('ownerUid').val() || auth.uid == data.parent().child('guestUid').val())",
          ".validate": "newData.isString() && (newData.val() == 'waiting' || newData.val() == 'schedule' || newData.val() == 'done')"
        },
        "schedule": {
          ".write": "auth != null && (auth.uid == data.parent().child('ownerUid').val() || auth.uid == data.parent().child('guestUid').val())",
          ".validate": "newData.val() == null || newData.val() == 'tomorrow_noon' || newData.val() == 'tomorrow_night'"
        },
        "noAttempts": {
          ".write": "auth != null && (auth.uid == data.parent().child('ownerUid').val() || auth.uid == data.parent().child('guestUid').val())",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
        },
        "updatedAt": {
          ".write": "auth != null && (auth.uid == data.parent().child('ownerUid').val() || auth.uid == data.parent().child('guestUid').val())"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid == data.parent().child('ownerUid').val()"
        },
        "ownerUid": {
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid"
        }
      }
    }
  }
}
